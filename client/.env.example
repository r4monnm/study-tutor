# Supabase — Project Settings → API. The browser gets ONLY the publishable/anon key.
# Every table has RLS enabled with zero policies, so this key can sign in and out but
# cannot read a single application row; all data flows through the API.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx
