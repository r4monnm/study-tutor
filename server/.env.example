# Anthropic credentials — get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Server
PORT=8787

# Models (override to experiment)
TUTOR_MODEL=claude-sonnet-5
GRADER_MODEL=claude-haiku-4-5
PROBLEM_MODEL=claude-sonnet-5

# Hint cap before the tutor switches to a parallel example
HINT_CAP=3

# Guardrail layer 2 (Haiku classifier). Set to false to measure the heuristic screen alone.
GUARDRAIL_CLASSIFIER=true

# Delayed-retention review: how long before a mastered card comes back (ms, default 12h)
RETENTION_THRESHOLD_MS=43200000

# Points awarded per genuine correct recall
POINTS_PER_CORRECT=10

# Local SQLite learner store path (only used by the optional SQLite store)
DB_PATH=data/study-tutor.db

# Supabase — Project Settings → API. Required: accounts, session/gate state, and
# durable progress all live in Postgres.
#   SUPABASE_SERVICE_ROLE_KEY bypasses RLS. Server-side only, never ship it to a browser.
SUPABASE_URL=https://your-project.supabase.co
# Only read by the live Supabase integration test (npm run test:supabase).
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxx
